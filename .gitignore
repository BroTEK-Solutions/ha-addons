# Local planning/spec scratch (never committed). Both directories are mirrored
# between machines by the agent config's own sync; a tracked copy here would
# commit scratch work and stop that sync.
docs/superpowers/
codex/

# Per-machine agent state: worktrees, scheduler locks, settings.local.json.
# The contributor kit's skills under .claude/skills/ are tracked.
.claude/*
!.claude/skills/

# Go build output from `go build` inside alloy/ui
/alloy/ui/alloy-ui

# Local `go build` output. These directories are copied verbatim into image
# build contexts by the sync scripts, so a stray binary must never linger.
shared/reporter/ha-reporter
synthetic_monitoring_shared/launcher/synthetic-monitoring-launcher
grafana_pdc/ui/grafana-pdc-ui
