#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Publishes the connector's health to Home Assistant over MQTT. This is a side
# channel and must never be able to disturb the tunnel, so it runs as its own
# service and stays quiet when no MQTT broker is configured.
REPORTER_APP=grafana_pdc
# A fresh data directory has no options file. Existing files must decode:
# unreadable/malformed options must not silently override a configured false.
REPORTER_MQTT_ENABLED=true
if [[ -e /data/options.json || -L /data/options.json ]]; then
    # Preserve false: jq's // operator would replace it with true.
    REPORTER_MQTT_ENABLED="$(jq -r 'if has("mqtt_enabled") then .mqtt_enabled else true end' /data/options.json)" || exit 1
fi
export REPORTER_APP REPORTER_MQTT_ENABLED
exec /usr/bin/ha-reporter
