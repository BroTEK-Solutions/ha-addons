#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# s6 supplies the service exit status as $1. When it is 256, $2 identifies the
# signal. SIGTERM is an intentional shutdown; any other signal is a crash that
# must stop the App rather than enter an invisible restart loop.
exit_code="${1:-1}"
exit_signal="${2:-0}"
results_dir="${S6_RESULTS_DIR:-/run/s6-linux-init-container-results}"
halt_command="${S6_HALT:-/run/s6/basedir/bin/halt}"

if [[ "$exit_code" -eq 0 || ( "$exit_code" -eq 256 && "$exit_signal" -eq 15 ) ]]; then
    bashio::log.info "Grafana PDC stopped."
    exit 0
fi

if [[ "$exit_code" -eq 256 ]]; then
    reported_exit=$((128 + exit_signal))
    bashio::log.fatal "Grafana PDC exited on signal ${exit_signal}; stopping the app."
    printf '%s' "$reported_exit" >"${results_dir}/exitcode"
    exec "$halt_command"
fi

bashio::log.fatal "Grafana PDC exited unexpectedly with code ${exit_code}; stopping the app."
printf '%s' "$exit_code" >"${results_dir}/exitcode"
exec "$halt_command"
