#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Reads the add-on options, validates them, and generates the Alloy config.
# ==============================================================================
set -e

# Overridable so the test suite can run this script outside a container.
CONFIG_DIR="${CONFIG_DIR:-/etc/alloy}"
DATA_DIR="${DATA_DIR:-/data/alloy}"
GENERATOR="${GENERATOR:-/usr/share/alloy/generate-config.sh}"
# The add-on config folder, where a user can place a full config.alloy override.
ADDON_CONFIG_DIR="${ADDON_CONFIG_DIR:-/config}"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OVERRIDE_FILE="${ADDON_CONFIG_DIR}/config.alloy"

mkdir -p "${CONFIG_DIR}" "${DATA_DIR}"

# A user-supplied config replaces the generated one wholesale. Handle it before
# reading any options: with an override there is nothing to validate, since the
# add-on options no longer describe what Alloy will do.
if [ -f "${OVERRIDE_FILE}" ]; then
    bashio::log.warning "Using ${OVERRIDE_FILE} instead of the generated configuration."
    bashio::log.warning "Add-on options are ignored, apart from the Alloy startup flags"
    bashio::log.warning "and the three passwords, which stay available as sys.env()."
    cp "${OVERRIDE_FILE}" "${CONFIG_FILE}"
    bashio::log.info "Alloy config copied to ${CONFIG_FILE}"
    exit 0
fi

# Read an option, falling back to $2 when it is unset, null or empty.
# bashio::config.has_value is what distinguishes those three from a real value -
# hand-rolling that check with jq is how the loki_url default ended up making a
# supposedly optional option mandatory.
config_or() {
    if bashio::config.has_value "${1}"; then
        bashio::config "${1}"
    else
        printf '%s' "${2:-}"
    fi
}

# Passwords are deliberately NOT read here - they are exported by the alloy
# service and referenced from the generated config via sys.env().
LOKI_URL=$(config_or loki_url)
LOKI_USERNAME=$(config_or loki_username)
LOGS_SYSTEM=$(config_or logs_system true)
LOGS_HOMEASSISTANT=$(config_or logs_homeassistant true)
LOGS_ADDONS=$(config_or logs_addons true)
LOGS_EXCLUDE_ADDONS=$(config_or logs_exclude_addons alloy)
LOGS_MAX_AGE=$(config_or logs_max_age 24h)
PROMETHEUS_URL=$(config_or prometheus_url)
PROMETHEUS_USERNAME=$(config_or prometheus_username)
INSTANCE_NAME=$(config_or instance_name homeassistant)
METRICS_SCRAPE_INTERVAL=$(config_or metrics_scrape_interval 60s)
HOST_METRICS=$(config_or host_metrics true)
HOMEASSISTANT_METRICS=$(config_or homeassistant_metrics false)
ALLOY_METRICS=$(config_or alloy_metrics true)
TEMPO_URL=$(config_or tempo_url)
TEMPO_USERNAME=$(config_or tempo_username)
TRACES_ENABLED=$(config_or traces_enabled false)
TRACES_NETWORK_ACCESS=$(config_or traces_network_access false)
PYROSCOPE_URL=$(config_or pyroscope_url)
PYROSCOPE_USERNAME=$(config_or pyroscope_username)
ALLOY_PROFILING=$(config_or alloy_profiling false)
LOG_LEVEL=$(config_or log_level info)
ADDITIONAL_CONFIG=$(config_or additional_config)
FLEET_URL=$(config_or fleet_url)
FLEET_USERNAME=$(config_or fleet_username)
FLEET_COLLECTOR_NAME=$(config_or fleet_collector_name)
FLEET_ATTRIBUTES=$(config_or fleet_attributes)
FLEET_POLL_FREQUENCY=$(config_or fleet_poll_frequency 1m)
OPERATION_MODE=$(config_or operation_mode)
OPERATION_MODE_EXPLICIT=false
[ -n "${OPERATION_MODE}" ] && OPERATION_MODE_EXPLICIT=true

# Upgrade compatibility: old releases allowed remote and local pipelines at the
# same time. Infer that state without advertising it as a new selectable mode.
if [ -z "${OPERATION_MODE}" ]; then
    local_destination="${LOKI_URL}${PROMETHEUS_URL}${TEMPO_URL}${PYROSCOPE_URL}"
    if [ -n "${FLEET_URL}" ] && [ -n "${local_destination}" ]; then
        OPERATION_MODE=legacy-hybrid
    elif [ -n "${FLEET_URL}" ]; then
        OPERATION_MODE=fleet
    else
        OPERATION_MODE=local
    fi
fi

export LOKI_URL LOKI_USERNAME PROMETHEUS_URL PROMETHEUS_USERNAME
export INSTANCE_NAME METRICS_SCRAPE_INTERVAL LOG_LEVEL ADDITIONAL_CONFIG
export HOST_METRICS HOMEASSISTANT_METRICS ALLOY_METRICS
export LOGS_SYSTEM LOGS_HOMEASSISTANT LOGS_ADDONS LOGS_EXCLUDE_ADDONS LOGS_MAX_AGE
export TEMPO_URL TEMPO_USERNAME TRACES_ENABLED TRACES_NETWORK_ACCESS
export PYROSCOPE_URL PYROSCOPE_USERNAME ALLOY_PROFILING
export FLEET_URL FLEET_USERNAME FLEET_COLLECTOR_NAME FLEET_ATTRIBUTES FLEET_POLL_FREQUENCY
export OPERATION_MODE

# Require a destination appropriate to the selected mode.
case "${OPERATION_MODE}" in
    fleet)
        if [ -z "${FLEET_URL}" ]; then
            bashio::log.fatal "Fleet mode requires fleet_url."
            bashio::exit.nok
        fi
        ;;
    local)
        if [ -z "${LOKI_URL}" ] && [ -z "${PROMETHEUS_URL}" ] \
            && [ -z "${TEMPO_URL}" ] && [ -z "${PYROSCOPE_URL}" ]; then
            bashio::log.fatal "Local mode requires at least one local destination."
            bashio::log.fatal "Set at least one of loki_url, prometheus_url, tempo_url or pyroscope_url."
            bashio::exit.nok
        fi
        ;;
    legacy-hybrid)
        if [ -z "${LOKI_URL}" ] && [ -z "${PROMETHEUS_URL}" ] \
            && [ -z "${TEMPO_URL}" ] && [ -z "${PYROSCOPE_URL}" ] \
            && [ -z "${FLEET_URL}" ]; then
            bashio::log.fatal "Set at least one of loki_url, prometheus_url, tempo_url,"
            bashio::log.fatal "pyroscope_url or fleet_url. All destinations are empty."
            bashio::exit.nok
        fi
        ;;
    *)
        bashio::log.fatal "operation_mode must be fleet or local."
        bashio::exit.nok
        ;;
esac

# Basic auth needs both halves; half a pair would silently 401 against the backend.
# $1 = option prefix (loki|prometheus|fleet)
check_auth_pair() {
    local user="" pass=""
    if bashio::config.has_value "${1}_username"; then user=1; fi
    if bashio::config.has_value "${1}_password"; then pass=1; fi
    if [ -n "${user}" ] && [ -z "${pass}" ]; then
        bashio::log.fatal "${1}_username is set but ${1}_password is empty."
        bashio::exit.nok
    fi
    if [ -z "${user}" ] && [ -n "${pass}" ]; then
        bashio::log.fatal "${1}_password is set but ${1}_username is empty."
        bashio::exit.nok
    fi
}

if [ "${OPERATION_MODE}" != fleet ]; then
    check_auth_pair loki
    check_auth_pair prometheus
    check_auth_pair tempo
    check_auth_pair pyroscope
fi

# Fleet uses a shared Grafana Cloud key. Accept fleet_password only as an
# upgrade bridge for existing installs.
fleet_secret=""
if bashio::config.has_value 'gcloud_rw_api_key' || bashio::config.has_value 'fleet_password'; then
    fleet_secret=1
fi
if [ "${OPERATION_MODE_EXPLICIT}" = true ] && [ "${OPERATION_MODE}" = fleet ]; then
    if [ -z "${FLEET_USERNAME}" ]; then
        bashio::log.fatal "Fleet mode requires fleet_username. Copy the numeric username from Grafana Cloud."
        bashio::exit.nok
    fi
    if [ -z "${fleet_secret}" ]; then
        bashio::log.fatal "Fleet mode requires gcloud_rw_api_key."
        bashio::exit.nok
    fi
fi
if [ -n "${FLEET_USERNAME}" ] && [ -z "${fleet_secret}" ]; then
    bashio::log.fatal "fleet_username is set but gcloud_rw_api_key is empty."
    bashio::exit.nok
fi
if [ -z "${FLEET_USERNAME}" ] && [ -n "${fleet_secret}" ]; then
    bashio::log.fatal "gcloud_rw_api_key is set but fleet_username is empty."
    bashio::exit.nok
fi

# Endpoints are interpolated into quoted River strings. Repeat the schema's URL
# checks here because options.json can be edited outside the UI, and an invalid
# URL otherwise fails later with an error that does not name the add-on option.
# Validate the standard full and compressed IPv6 forms. An IPv4 dotted-decimal
# tail occupies two hextets, so validate it separately and substitute two
# hextets before applying the same IPv6 structure check.
validate_ipv6_literal() {
    local value="${1}" hex='[0-9A-Fa-f]{1,4}' pattern ipv4 octet
    if [[ "${value}" == *.* ]]; then
        [[ "${value}" == *:* ]] || return 1
        ipv4="${value##*:}"
        local -a octets
        IFS='.' read -r -a octets <<<"${ipv4}"
        [[ "${#octets[@]}" -eq 4 ]] || return 1
        for octet in "${octets[@]}"; do
            [[ "${octet}" =~ ^(0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$ ]] || return 1
        done
        value="${value%:*}:0:0"
    fi
    pattern="^(((${hex}:){7}${hex})|((${hex}:){1,7}:)|((${hex}:){1,6}:${hex})|((${hex}:){1,5}(:${hex}){1,2})|((${hex}:){1,4}(:${hex}){1,3})|((${hex}:){1,3}(:${hex}){1,4})|((${hex}:){1,2}(:${hex}){1,5})|(${hex}:((:${hex}){1,6}))|(:((:${hex}){1,7}|:)))$"
    [[ "${value}" =~ ${pattern} ]]
}

validate_url() {
    local name="${1}" value="${2}"
    [ -n "${value}" ] || return 0
    case "${value}" in
        *'"'*|*[\\]*|*[[:space:]]*)
            bashio::log.fatal "${name} contains a quote, backslash or whitespace: '${value}'"
            bashio::exit.nok
            ;;
    esac

    local rest authority port="" unescaped ipv6_literal zone
    case "${value}" in
        http://*) rest="${value#http://}" ;;
        https://*) rest="${value#https://}" ;;
        *)
            bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
            bashio::exit.nok
            ;;
    esac

    # Strip path, query and fragment, leaving the authority to validate. IPv6
    # literals must be bracketed so their colons cannot be mistaken for a port.
    authority="${rest%%[/?#]*}"
    local ipv6_authority='^\[([^]]+)\](:([0-9]+))?$'
    local host_authority='^[A-Za-z0-9._-]+(:([0-9]+))?$'
    if [[ "${authority}" =~ ${ipv6_authority} ]]; then
        ipv6_literal="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[3]}"
        # RFC 6874 requires the percent introducing an IPv6 zone identifier to
        # appear as %25 inside a URI. Zone IDs use URI-unreserved characters or
        # further percent escapes, which covers ordinary interface names.
        if [[ "${ipv6_literal}" == *%25* ]]; then
            zone="${ipv6_literal#*%25}"
            ipv6_literal="${ipv6_literal%%\%25*}"
            if [[ ! "${zone}" =~ ^([A-Za-z0-9._~-]|%[0-9A-Fa-f]{2})+$ ]]; then
                bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
                bashio::exit.nok
            fi
        elif [[ "${ipv6_literal}" == *%* ]]; then
            bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
            bashio::exit.nok
        fi
        if ! validate_ipv6_literal "${ipv6_literal}"; then
            bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
            bashio::exit.nok
        fi
    elif [[ "${authority}" =~ ${host_authority} ]]; then
        port="${BASH_REMATCH[2]}"
    else
        bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
        bashio::exit.nok
    fi

    if [ -n "${port}" ] && { [ "${#port}" -gt 5 ] || ((10#${port} < 1 || 10#${port} > 65535)); }; then
        bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
        bashio::exit.nok
    fi

    # Remove valid percent escapes one at a time; any percent left afterwards
    # begins an incomplete or non-hex escape.
    unescaped="${value}"
    while [[ "${unescaped}" =~ %[0-9A-Fa-f][0-9A-Fa-f] ]]; do
        unescaped="${unescaped/"${BASH_REMATCH[0]}"/}"
    done
    if [[ "${unescaped}" == *%* ]]; then
        bashio::log.fatal "${name} is not a valid HTTP(S) URL: '${value}'"
        bashio::exit.nok
    fi
}

if [ "${OPERATION_MODE}" != fleet ]; then
    validate_url loki_url "${LOKI_URL}"
    validate_url prometheus_url "${PROMETHEUS_URL}"
    validate_url tempo_url "${TEMPO_URL}"
    validate_url pyroscope_url "${PYROSCOPE_URL}"
fi
if [ "${OPERATION_MODE}" != local ]; then
    validate_url fleet_url "${FLEET_URL}"
fi

if [ "${OPERATION_MODE}" != fleet ] && [ "${TRACES_ENABLED}" = true ] && [ -z "${TEMPO_URL}" ]; then
    bashio::log.fatal "traces_enabled is on but tempo_url is empty."
    bashio::exit.nok
fi
if [ "${OPERATION_MODE}" != fleet ] && [ "${ALLOY_PROFILING}" = true ] && [ -z "${PYROSCOPE_URL}" ]; then
    bashio::log.fatal "alloy_profiling is on but pyroscope_url is empty."
    bashio::exit.nok
fi

# Both metric sources forward to the Prometheus remote_write receiver, which
# only exists when prometheus_url is set. Enabling one without it would silently
# collect nothing.
if [ "${OPERATION_MODE}" != fleet ] && [ -z "${PROMETHEUS_URL}" ]; then
    if bashio::config.true 'homeassistant_metrics'; then
        bashio::log.fatal "homeassistant_metrics is enabled but prometheus_url is empty."
        bashio::log.fatal "Set prometheus_url, or turn homeassistant_metrics off."
        bashio::exit.nok
    fi
elif [ "${OPERATION_MODE}" != fleet ] && [ "${HOST_METRICS}" != "true" ] \
    && [ "${HOMEASSISTANT_METRICS}" != "true" ] && [ "${ALLOY_METRICS}" != "true" ]; then
    bashio::log.warning "prometheus_url is set but both host_metrics and"
    bashio::log.warning "homeassistant_metrics are off, so no metrics will be sent."
fi

# Attributes are emitted verbatim into the Alloy config. The schema already
# rejects a malformed pair in the UI; this repeats the check because a quote or
# backslash would break River string syntax, and because options.json can be
# edited outside the UI.
validate_attributes() {
    [ -n "${FLEET_ATTRIBUTES}" ] || return 0
    local -a pairs
    IFS=',' read -r -a pairs <<<"${FLEET_ATTRIBUTES}"
    local pair
    for pair in "${pairs[@]}"; do
        case "${pair}" in
            *'"'*|*[\\]*)
                bashio::log.fatal "fleet_attributes entry '${pair}' contains a quote or backslash."
                bashio::exit.nok
                ;;
        esac
        case "${pair}" in
            *=*) ;;
            *)
                bashio::log.fatal "fleet_attributes entry '${pair}' is not key=value."
                bashio::exit.nok
                ;;
        esac
        if [ -z "${pair%%=*}" ]; then
            bashio::log.fatal "fleet_attributes entry '${pair}' has an empty key."
            bashio::exit.nok
        fi
    done
}

validate_attributes

# Describe auth for the startup banner - never the secret itself.
auth_note() {
    if [ -n "$1" ]; then echo "(auth: basic, user=$1)"; else echo "(no auth)"; fi
}

# Detect journal path (logs only)
export JOURNAL_PATH="/var/log/journal"
if [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    export JOURNAL_PATH="/run/log/journal"
fi

bashio::log.info "Grafana Alloy for Home Assistant"
[ -n "${LOKI_URL}" ] && \
    bashio::log.info "Logs    -> Loki:       ${LOKI_URL} $(auth_note "${LOKI_USERNAME}")"
[ -n "${PROMETHEUS_URL}" ] && \
    bashio::log.info "Metrics -> Prometheus: ${PROMETHEUS_URL} (every ${METRICS_SCRAPE_INTERVAL}) $(auth_note "${PROMETHEUS_USERNAME}")"
[ -n "${PROMETHEUS_URL}" ] && \
    bashio::log.info "Metric sources: host=${HOST_METRICS} homeassistant=${HOMEASSISTANT_METRICS}"
[ -n "${FLEET_URL}" ] && \
    bashio::log.info "Fleet   -> Fleet Mgmt: ${FLEET_URL} (every ${FLEET_POLL_FREQUENCY}) $(auth_note "${FLEET_USERNAME}")"
[ -n "${FLEET_ATTRIBUTES}" ] && bashio::log.info "Fleet attributes: ${FLEET_ATTRIBUTES}"
[ -n "${LOKI_URL}" ] && bashio::log.info "Journal path: ${JOURNAL_PATH}"
bashio::log.info "Instance: ${INSTANCE_NAME}"
bashio::log.info "Log level: ${LOG_LEVEL}"

# Generate Alloy config.
# Invoke via `bash` (not the shebang) so the exported options above are inherited;
# the generator must NOT run under with-contenv, which would reset the environment.
bash "${GENERATOR}" > "${CONFIG_FILE}"

bashio::log.info "Alloy config generated at ${CONFIG_FILE}"
