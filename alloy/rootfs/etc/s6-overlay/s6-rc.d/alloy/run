#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Runs Grafana Alloy against the config generated by init-alloy.
# ==============================================================================
# The generated config references sys.env("LOKI_PASSWORD") /
# sys.env("PROMETHEUS_PASSWORD") / sys.env("FLEET_PASSWORD"); export them here
# (init-alloy/run's environment does not propagate to this long-running service).
secret() {
    if bashio::config.has_value "${1}"; then
        bashio::config "${1}"
    else
        printf ''
    fi
}

LOKI_PASSWORD=$(secret loki_password)
PROMETHEUS_PASSWORD=$(secret prometheus_password)
FLEET_PASSWORD=$(secret fleet_password)
export LOKI_PASSWORD PROMETHEUS_PASSWORD FLEET_PASSWORD

# Startup flags. The first three are fixed: the listen address is what the
# ingress-free debug UI and the health check both use, and the storage path is
# the one excluded from backups.
declare -a args=(
    --server.http.listen-addr=0.0.0.0:12345
    --storage.path=/data/alloy
)

# Alloy refuses to load a component below the permitted stability level, so this
# is the switch that makes public-preview and experimental components usable.
args+=("--stability.level=$(bashio::config 'alloy_stability_level' 'generally-available')")

# Alloy reports anonymous usage statistics to Grafana by default.
if bashio::config.true 'alloy_disable_telemetry'; then
    args+=(--disable-reporting)
fi

# Anything else the user wants to pass. Split on whitespace, which is what a
# flag string looks like; a flag whose value contains a space needs the
# config.alloy override instead.
if bashio::config.has_value 'alloy_additional_args'; then
    read -r -a extra_args <<<"$(bashio::config 'alloy_additional_args')"
    args+=("${extra_args[@]}")
    bashio::log.info "Extra Alloy flags: ${extra_args[*]}"
fi

exec /usr/bin/alloy run "${args[@]}" /etc/alloy/config.alloy
