#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Runs Grafana Alloy against the config generated by init-alloy.
# ==============================================================================
# The generated config references secrets through sys.env(); export them from
# the ingress-owned v2 settings store. Native App options are recovery-only.
SETTINGS_FILE="${SETTINGS_FILE:-/data/settings.json}"

setting() {
    jq -r --arg key "${1}" \
        'if has($key) and .[$key] != null then .[$key] else empty end' \
        "${SETTINGS_FILE}"
}

LOKI_PASSWORD=$(setting loki_password)
PROMETHEUS_PASSWORD=$(setting prometheus_password)
GCLOUD_RW_API_KEY=$(setting gcloud_rw_api_key)
TEMPO_PASSWORD=$(setting tempo_password)
PYROSCOPE_PASSWORD=$(setting pyroscope_password)
export LOKI_PASSWORD PROMETHEUS_PASSWORD GCLOUD_RW_API_KEY
export TEMPO_PASSWORD PYROSCOPE_PASSWORD

# Startup flags. The first four are fixed: ingress proxies the prefixed UI,
# health and self-monitoring use the same listener, and the storage path is the
# one excluded from backups.
declare -a args=(
    --server.http.listen-addr=127.0.0.1:12345
    --server.http.ui-path-prefix=/alloy
    --storage.path=/data/alloy
)

# Alloy refuses to load a component below the permitted stability level, so this
# is the switch that makes public-preview and experimental components usable.
stability_level=$(setting alloy_stability_level)
[ -n "${stability_level}" ] || stability_level=generally-available
args+=("--stability.level=${stability_level}")

# Alloy reports anonymous usage statistics to Grafana by default.
disable_telemetry=$(setting alloy_disable_telemetry)
if [ -z "${disable_telemetry}" ] || [ "${disable_telemetry}" = true ]; then
    args+=(--disable-reporting)
fi

# Anything else the user wants to pass. Split on whitespace, which is what a
# flag string looks like; a flag whose value contains a space needs the
# config.alloy override instead.
additional_args=$(setting alloy_additional_args)
if [ -n "${additional_args}" ]; then
    declare -a extra_args=()
    mapfile -d '' -t extra_args < <(
        jq -j --arg key alloy_additional_args \
            '(.[$key] // "") | scan("\\S+") | (., "\u0000")' \
            "${SETTINGS_FILE}"
    )
    args+=("${extra_args[@]}")
    bashio::log.info "Extra Alloy flags: ${extra_args[*]}"
fi

exec /usr/bin/alloy run "${args[@]}" /etc/alloy/config.alloy
