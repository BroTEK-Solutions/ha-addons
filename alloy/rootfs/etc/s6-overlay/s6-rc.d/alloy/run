#!/usr/bin/with-contenv bash
# The generated config references sys.env("LOKI_PASSWORD") / sys.env("PROMETHEUS_PASSWORD");
# export them here (init-alloy/run's env does not propagate to this long-running service).
LOKI_PASSWORD=$(jq -r '.loki_password // ""' /data/options.json)
PROMETHEUS_PASSWORD=$(jq -r '.prometheus_password // ""' /data/options.json)
export LOKI_PASSWORD PROMETHEUS_PASSWORD
exec /usr/bin/alloy run \
    --server.http.listen-addr=0.0.0.0:12345 \
    --storage.path=/data/alloy \
    /etc/alloy/config.alloy
