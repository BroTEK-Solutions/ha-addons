{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "12 hours",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Grafana Alloy release pinned in the App Dockerfile. This is the single source of truth for the version - alloy/tests/generate-config.test.sh parses it out of the same line.",
      "managerFilePatterns": ["/^alloy/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ALLOY_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the App build, manifest, and multi-architecture matrix actions on one Home Assistant builder release.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/builder"],
      "groupName": "Home Assistant builder App actions"
    },
    {
      "description": "Keep Home Assistant metadata and App discovery helpers on one actions revision.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/actions"],
      "groupName": "Home Assistant App helper actions"
    },
    {
      "description": "Keep shared security workflows on their reviewed floating ref",
      "matchDepNames": ["rknightion/.github"],
      "pinDigests": false,
      "enabled": false
    },
    {
      "description": "Automerge GitHub Actions after CI",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "labels": ["dep:gha"]
    },
    {
      "description": "Automerge non-major App dependencies after CI",
      "matchPackageNames": [
        "grafana/alloy",
        "grafana/pdc-agent",
        "ghcr.io/home-assistant/base",
        "ghcr.io/home-assistant/base-debian"
      ],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "labels": ["dep:low-risk"]
    },
    {
      "description": "Review CI runtime updates manually",
      "matchPackageNames": ["python", "ubuntu"],
      "automerge": false,
      "labels": ["dep:toolchain"]
    }
  ]
}
