#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# The reporter is optional telemetry, so its failure must never stop the App.
# A configuration fault here is deterministic and would otherwise restart in a
# hot loop, so back off before S6 brings it up again.
declare exit_code="${1:-0}"
declare exit_signal="${2:-0}"

if [[ "${exit_code}" -eq 256 ]] && [[ "${exit_signal}" -eq 15 ]]; then
    exit 0
fi
if [[ "${exit_code}" -ne 0 ]]; then
    bashio::log.warning "MQTT reporter exited (code ${exit_code}); Alloy is unaffected. Retrying shortly."
    sleep 30
fi
exit 0
